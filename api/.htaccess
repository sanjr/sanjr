# COPA MCQ API – protect the config and internal files
Options -Indexes
<FilesMatch "^(config\.php|config\.local\.php|\.schema-v1.*|.*\.sqlite)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
